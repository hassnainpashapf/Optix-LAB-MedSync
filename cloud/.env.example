# --- LabPOS cloud API (.env) — copy to .env and fill in ---

# Host port mapped to the API container (API always listens on 4000 inside)
API_PORT=4000

# Storage adapter: pg (production) | sqlite (quick local test, no docker needed)
DB_ADAPTER=pg

# Postgres credentials (used by both db and api services).
# Avoid characters that break shell parsing in the password, or quote it.
POSTGRES_USER=labpos
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=labpos

# Optional: full connection string. When set, it wins over the PG* vars above.
# Remember to URL-encode special characters in the password.
# DATABASE_URL=postgres://labpos:change-me@db:5432/labpos

# Secret key guarding the superadmin lab-registry endpoints.
# The superadmin dashboard sends it as header X-Superadmin-Key.
SUPERADMIN_KEY=change-me-to-a-long-random-secret

# Public HTTPS URL of this API (after reverse proxy). Used by /api-config.js
# so linked frontends know where the API lives.
PUBLIC_API_URL=https://labpos-api.example.com

# Optional display name stamped into the seeded settings row on first boot.
LAB_NAME=

# Optional: override the installer download URL served by GET /api/version.
# When empty, releases.json -> bundleUrl is used.
RELEASE_BUNDLE_URL=

# --- Authentication (required for production) ---

# Replaces the shipped default admin password (admin123) on boot. The password
# is stored hashed (scrypt); existing plaintext passwords are hashed on first start.
ADMIN_PASSWORD=

# HMAC secret that signs login tokens. Leave empty to auto-generate and keep it in the DB.
SESSION_SECRET=

# Login token lifetime in hours (default 12)
TOKEN_TTL_HOURS=12

# Comma-separated browser origins allowed to call the API (CORS). Empty = any origin.
# Recommended: your Cloudflare Pages site, e.g.
CORS_ORIGINS=https://optix-lab-medsync.pages.dev

# Value the superadmin console sends as X-Superadmin-Key after username/password login
# ('up:' + sha256('<username>:<password>')); optional if SUPERADMIN_KEY is used directly.
# SUPERADMIN_LOGIN_TOKEN=
